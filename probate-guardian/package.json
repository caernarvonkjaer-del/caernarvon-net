{
  "name": "probate-guardian",
  "private": true,
  "version": "1.5.30",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build && node scripts/generate-service-worker.mjs",
    "build:portable": "vite build --mode portable",
    "build": "npm run build:web && npm run build:portable",
    "preview:web": "vite preview --outDir dist/web",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:source": "node scripts/run-e2e-profile.mjs source",
    "test:e2e:web": "node scripts/run-e2e-profile.mjs web",
    "test:e2e:portable": "node scripts/run-e2e-profile.mjs portable",
    "test:e2e:firefox": "node scripts/run-e2e-profile.mjs firefox",
    "test:e2e:webkit": "node scripts/run-e2e-profile.mjs webkit",
    "test:e2e:edge": "node scripts/run-e2e-profile.mjs edge",
    "test:e2e:all-profiles": "node scripts/run-e2e-profile.mjs all",
    "test": "npm run test:unit && npm run test:e2e",
    "check:types": "tsc --noEmit",
    "measure:baseline": "node scripts/measure-baseline.mjs",
    "measure:lifecycle": "node scripts/measure-lifecycle.mjs",
    "generate:fonts": "node scripts/generate-embedded-font.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.3.289",
    "subset-font": "^2.7.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  }
}

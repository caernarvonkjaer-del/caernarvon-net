{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "allowJs": true,
    "strict": false
  },
  "include": [
    "src/core/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
